+    hasStarted:music.hasStarted,volume:music.volume,muted:music.muted,currentTime:music.currentTime,
+    duration:music.duration,errorMessage:music.errorMessage,
+  }),[music]);
+  const snapshotRef=useRef(state);snapshotRef.current=state;
+  useEffect(()=>{
+    // Same-origin callers invoke actions directly in their trusted click stack.
+    // Never defer Play through postMessage or create a second audio element.
+    const api={
+      getState:()=>structuredClone(snapshotRef.current),
+      subscribe(callback:(state:object)=>void){listeners.current.add(callback);callback(structuredClone(snapshotRef.current));return()=>{listeners.current.delete(callback);};},
+      playAlbum:(id:string)=>current.current.playAlbum(id),playTrack:(id:string)=>current.current.playTrack(id),
