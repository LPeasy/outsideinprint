+import type { MusicAlbum, MusicPlaylist, MusicTrack } from "./playlist";
+import { DEFAULT_MUSIC_SETTINGS, normalizeMusicSettings } from "./settings";
+import { buildShuffleOrder } from "./shuffle";
+
+export type MusicPlayerState = {
+  playlistStatus: "loading" | "empty" | "ready" | "error";
+  station: string;
+  tracks: MusicTrack[];
+  albums: MusicAlbum[];
+  currentTrack: MusicTrack | null;
+  currentAlbum: MusicAlbum | null;
+  currentTrackIndex: number;
+  currentAlbumTrackIndex: number;
+  currentAlbumTrackCount: number;
+  isPlaying: boolean;
+  isBuffering: boolean;
+  hasStarted: boolean;
+  volume: number;
+  muted: boolean;
+  shuffle: boolean;
+  favoriteTrackIds: string[];
+  currentTime: number;
+  duration: number;
+  errorMessage: string | null;
+};
+
+export const initialMusicState = (): MusicPlayerState => ({
+  playlistStatus: "loading", station: "Pressroom Radio", tracks: [], albums: [], currentTrack: null,
+  currentAlbum: null, currentTrackIndex: 0, currentAlbumTrackIndex: 0, currentAlbumTrackCount: 0,
+  isPlaying: false, isBuffering: false, hasStarted: false, volume: DEFAULT_MUSIC_SETTINGS.volume,
+  muted: false, shuffle: false, favoriteTrackIds: [], currentTime: 0, duration: 0, errorMessage: null
+});
+
+// One media element, shared by cabinet, site controls, Media Session and tray.
+// All Play methods reach audio.play() in the caller's synchronous gesture path.
+export class MusicPlayerController {
+  private state = initialMusicState();
+  private listeners = new Set<() => void>();
+  private handlers: Array<[string, EventListener]> = [];
+  private playRequest = 0;
+  private playRequested = false;
+  private suspended = false;
+  private resumeAfterSuspend = false;
+  private disposed = false;
+  private history: number[] = [];
+  private shuffleQueue: number[] = [];
+
+  constructor(readonly audio: HTMLAudioElement, private options: { lazyAudio?: boolean; baseURI: string; random?: () => number }) {
+    audio.preload = options.lazyAudio ? "none" : "auto";
+    audio.volume = this.state.volume;
+    const listen = (type: string, callback: () => void) => { const handler: EventListener = callback; this.handlers.push([type, handler]); audio.addEventListener(type, handler); };
+    listen("playing", () => this.markPlaying());
+    listen("pause", () => {
+      if (!audio.paused) return;
+      this.playRequest++; this.playRequested = false;
+      this.update({ isPlaying: false, isBuffering: false });
+    });
+    listen("waiting", () => { if (this.playRequested && !audio.paused) this.update({ isBuffering: true }); });
+    listen("loadedmetadata", () => this.update({ duration: Number.isFinite(audio.duration) ? audio.duration : this.state.currentTrack?.duration ?? 0 }));
+    listen("timeupdate", () => this.update({ currentTime: audio.currentTime }));
+    listen("ended", () => this.advance(true));
+    listen("error", () => {
+      this.playRequest++; this.playRequested = false; this.resumeAfterSuspend = false;
+      audio.pause();
+      this.update({ isPlaying: false, isBuffering: false, errorMessage: this.state.currentTrack ? `Could not play "${this.state.currentTrack.title}". Try another track.` : "This track could not be played." });
+    });
+  }
+
+  getState = (): MusicPlayerState => this.state;
+  subscribe = (listener: () => void) => { this.listeners.add(listener); return () => { this.listeners.delete(listener); }; };
+  private update(patch: Partial<MusicPlayerState>) {
+    if (this.disposed) return;
+    this.state = { ...this.state, ...patch };
+    this.listeners.forEach(listener => listener());
+  }
+
+  configure(playlist: MusicPlaylist, saved: unknown) {
+    const settings = normalizeMusicSettings(saved), known = new Set(playlist.tracks.map(track => track.id));
+    const savedIndex = playlist.tracks.findIndex(track => track.id === settings.currentTrackId);
+    const defaultIndex = playlist.tracks.findIndex(track => track.id === playlist.defaultTrackId);
+    this.audio.volume = settings.volume; this.audio.muted = settings.muted;
+    this.update({ tracks: playlist.tracks, albums: playlist.albums, station: playlist.station,
+      playlistStatus: playlist.tracks.length ? "ready" : "empty", volume: settings.volume, muted: settings.muted,
+      shuffle: settings.shuffle, favoriteTrackIds: settings.favoriteTrackIds.filter(id => known.has(id)) });
+    if (playlist.tracks.length) this.select(savedIndex >= 0 ? savedIndex : Math.max(0, defaultIndex), false, false);
+  }
+  failLoad(message: string) { this.update({ playlistStatus: "error", errorMessage: message }); }
+
+  private select(index: number, autoplay: boolean, remember = true) {
+    if (this.disposed || !this.state.tracks.length || !Number.isFinite(index)) return;
+    const safeIndex = ((Math.floor(index) % this.state.tracks.length) + this.state.tracks.length) % this.state.tracks.length;
+    const track = this.state.tracks[safeIndex], album = this.state.albums.find(group => group.id === track.albumId) ?? null;
+    const changedAlbum = this.state.currentAlbum?.id !== album?.id;
+    if (changedAlbum) { this.history = []; this.shuffleQueue = []; }
+    else if (remember && this.state.currentTrack && this.state.currentTrackIndex !== safeIndex) this.history = [...this.history, this.state.currentTrackIndex].slice(-50);
+    this.playRequest++; this.playRequested = false;
+    this.audio.pause();
+    this.update({ currentTrackIndex: safeIndex, currentTrack: track, currentAlbum: album,
+      currentAlbumTrackIndex: Math.max(0, album?.trackIds.indexOf(track.id) ?? 0), currentAlbumTrackCount: album?.trackIds.length ?? 0,
+      currentTime: 0, duration: track.duration ?? 0, isPlaying: false, isBuffering: false, errorMessage: null });
+    if (this.options.lazyAudio && !autoplay) {
+      if (this.audio.getAttribute("src")) { this.audio.removeAttribute("src"); this.audio.load(); }
+    } else if (!this.suspended || !this.options.lazyAudio) this.ensureSource(true);
+    if (autoplay) this.play();
+  }
+
+  private ensureSource(restart = false) {
+    const track = this.state.currentTrack;
