+    return()=>{if(target.oipBobMusic===api)delete target.oipBobMusic;listeners.current.clear();};
+  },[]);
+  useEffect(()=>{listeners.current.forEach(callback=>callback(structuredClone(state)));},[state]);
+  return null;
+}
