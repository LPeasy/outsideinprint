+  removeAttribute(name: string) { if (name === "src") this.src = ""; }
+  load() { this.loads.push(this.src); this.currentTime = 0; }
+  play() {
+    this.paused = false; this.dispatchEvent(new Event("play"));
+    return new Promise<void>((resolve, reject) => this.calls.push({ resolve, reject }));
+  }
+  pause() { const changed = !this.paused; this.paused = true; if (changed) this.dispatchEvent(new Event("pause")); }
+  started(index = this.calls.length - 1) { this.paused = false; this.dispatchEvent(new Event("playing")); this.calls[index].resolve(); }
