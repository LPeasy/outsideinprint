name = "oip-commerce-consumer"
main = "consumer/index.js"
compatibility_date = "2026-08-01"
compatibility_flags = ["global_fetch_strictly_public"]
workers_dev = false
preview_urls = false

[observability]
enabled = true
head_sampling_rate = 1

[vars]
SQUARE_API_BASE_URL = "https://connect.squareup.com"
SQUARE_API_VERSION = "SET_DURING_PROVISIONING"
DOWNLOAD_BASE_URL = "https://downloads.outsideinprint.org"
DOWNLOAD_EMAIL_FROM = "Outside In Print <downloads@outsideinprint.org>"
DOWNLOAD_EMAIL_REPLY_TO = "support@outsideinprint.org"
REQUIRE_EPUB_US_COUNTRY_PROOF = "true"
EPUB_ENABLED_SKUS = ""
SQUARE_EPUB_CATALOG_VARIATION_IDS = "{}"
POINTMATCH_DATASET_VERSION = "SET_DURING_PROVISIONING"
POINTMATCH_SCHEMA_VERSION = "oip-pointmatch-v1"
POINTMATCH_SHARD_PREFIX = "pointmatch"
POINTMATCH_INDEX_ROOT_SHA256 = "SET_DURING_PROVISIONING"
FL_SALES_TAX_RATE_VERSION = "SET_DURING_PROVISIONING"
FL_SALES_TAX_RATE_ROOT_SHA256 = "SET_DURING_PROVISIONING"
US_ZIP_STATE_PROVIDER = ""
USPS_ADDRESSES_API_BASE_URL = ""
USPS_OAUTH_TOKEN_URL = ""
USPS_ADDRESSES_API_VERSION = ""
SQUARE_INVENTORY_TRANSACTION_ID_KIND = ""
OPERATIONS_MONITORING_ENABLED = "false"
OPERATIONAL_ENVIRONMENT = "PRODUCTION"
OPERATIONAL_HEALTHCHECK_URL = "https://downloads.outsideinprint.org/health"
OPERATIONAL_PRIMARY_QUEUE = "oip-commerce-events"
OPERATIONAL_DLQ_QUEUE = "oip-commerce-events-dlq"
OPERATIONAL_CANARY_STALE_SECONDS = "600"
OPERATIONAL_FULFILLMENT_STALE_SECONDS = "900"
OPERATIONAL_ALERT_REPEAT_SECONDS = "21600"

[triggers]
crons = ["*/5 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "oip-commerce"
database_id = "SET_DURING_PROVISIONING"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "EPUB_BUCKET"
bucket_name = "oip-private-epubs"

[[r2_buckets]]
binding = "JURISDICTION_BUCKET"
bucket_name = "oip-private-jurisdiction"

[[queues.producers]]
binding = "OPERATIONAL_CANARY_QUEUE"
queue = "oip-commerce-events"

[[queues.consumers]]
queue = "oip-commerce-events"
max_batch_size = 1
max_batch_timeout = 1
max_retries = 10
dead_letter_queue = "oip-commerce-events-dlq"
max_concurrency = 1

[[queues.consumers]]
queue = "oip-commerce-events-dlq"
max_batch_size = 1
max_batch_timeout = 1
max_retries = 10
max_concurrency = 1

# Set with Cloudflare secret bindings, never in this file:
# SQUARE_ACCESS_TOKEN
# SQUARE_LOCATION_ID
# RESEND_API_KEY
# OPERATIONAL_ALERT_EMAIL (consumer-only owner-direct protected recipient)
# EMAIL_HASH_PEPPER
# DOWNLOAD_TOKEN_SECRET
# ADDRESS_LOOKUP_HMAC_SECRET
# USPS_API_CLIENT_ID
# USPS_API_CLIENT_SECRET
